# Copy to .env for local development. On Render, add each of these under
# Environment instead (never commit real values).

# --- server ---
NODE_ENV=production
# proxies in front of the app: 2 when Netlify forwards /api to Render, 1 for Render alone
TRUST_PROXY=2
# your Netlify address, e.g. https://job-forest.netlify.app (comma-separate several)
CORS_ORIGIN=

# --- database (MongoDB Atlas) ---
MONGO_URI=

# --- login tokens: a long random string ---
JWT_SECRET=

# --- Cloudinary (profile photos, logos, resumes) ---
CLOUD_NAME=
CLOUD_API=
API_SECRET=

# --- Gmail OAuth2 (OTP emails) ---
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# --- AI (chatbot + related jobs), any OpenAI-compatible provider ---
AI_BASE_URL=https://api.fastrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b:free
